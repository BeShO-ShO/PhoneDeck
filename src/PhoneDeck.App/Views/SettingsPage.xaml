<Page x:Class="PhoneDeck.App.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      xmlns:conv="clr-namespace:PhoneDeck.App.Converters"
      Title="Settings">

  <Page.Resources>
    <conv:InverseBoolConverter x:Key="InverseBool" />
    <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  </Page.Resources>

  <StackPanel Margin="16,4,16,16">
    <ui:TextBlock Text="Control how PhoneDeck starts and what happens when the window is closed."
                  FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  TextWrapping="Wrap" Margin="0,0,0,20" />

    <ui:InfoBar x:Name="DevBar" Severity="Informational" IsClosable="False" Margin="0,0,0,16"
                Title="Auto-start unavailable"
                Message="Run the published executable rather than 'dotnet run' to register auto-start." />

    <ui:CardControl Icon="{ui:SymbolIcon Power24}" Margin="0,0,0,8">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Start with Windows" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Launches hidden in the notification area when you sign in." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch x:Name="AutoStartToggle" Click="OnAutoStartChanged" />
    </ui:CardControl>

    <ui:CardControl Icon="{ui:SymbolIcon Play24}" Margin="0,0,0,8">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Start the peripheral automatically" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Begins advertising as soon as the app launches." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch IsChecked="{Binding StartPeripheralOnLaunch, Mode=TwoWay}" />
    </ui:CardControl>

    <ui:CardControl Icon="{ui:SymbolIcon ArrowMinimize24}" Margin="0,0,0,8">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Keep running when the window is closed" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Paired hosts reconnect to a peripheral that never restarted, so staying resident keeps them working." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
    </ui:CardControl>

    <ui:Card Margin="0,0,0,8" Padding="16,12,16,16">
      <StackPanel>
        <ui:TextBlock Text="Switching between the phone and this PC" FontTypography="BodyStrong" />
        <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap" Margin="0,2,0,12"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      Text="How the keyboard and mouse go to the phone and come back. Changes apply the next time capture starts." />

        <ui:TextBlock Text="Hotkey that turns it on and off (click the box, then press the new keys)" FontTypography="Caption" Margin="0,0,0,4" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
          <TextBox x:Name="HotkeyBox" Width="200" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                   FontFamily="Cascadia Mono, Consolas"
                   GotKeyboardFocus="OnHotkeyBoxFocused" LostKeyboardFocus="OnHotkeyBoxUnfocused"
                   PreviewKeyDown="OnHotkeyBoxKey" />
          <ui:Button Content="Reset to Ctrl+Alt+Q" Margin="8,0,0,0" Click="OnResetHotkey" />
        </StackPanel>
        <ui:TextBlock x:Name="HotkeyStatus" FontTypography="Caption" TextWrapping="Wrap" Margin="0,0,0,10"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <CheckBox Content="Click or touch the phone's picture to control the phone" Margin="0,0,0,6"
                  IsChecked="{Binding ClickPictureToControl, Mode=TwoWay}" />
        <CheckBox Content="Tap Ctrl+Alt (on their own) to return to this PC" Margin="0,0,0,6"
                  IsChecked="{Binding CtrlAltTapReturns, Mode=TwoWay}" />
        <CheckBox Content="The Copilot key returns to this PC (on keyboards that have one)" Margin="0,0,0,6"
                  IsChecked="{Binding CopilotKeyReturns, Mode=TwoWay}" />
        <CheckBox Content="Touch the screen outside the picture to return to this PC" Margin="0,0,0,6"
                  IsChecked="{Binding TouchOutsideReturns, Mode=TwoWay}" />
        <CheckBox Content="Hide PhoneDeck's window to the tray when the phone takes control" Margin="0,0,0,6"
                  IsChecked="{Binding HideWindowOnCapture, Mode=TwoWay}" />
        <CheckBox Content="Show a short note when control changes hands"
                  IsChecked="{Binding ShowControlIndicator, Mode=TwoWay}" />
      </StackPanel>
    </ui:Card>

    <ui:CardControl Icon="{ui:SymbolIcon Cursor24}" Margin="0,0,0,8">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Shake the pointer to switch target" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Move the mouse rapidly back and forth to cycle between this PC and the paired hosts. Ctrl+Alt+CapsLock always works too." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch x:Name="SwitchGestureToggle" Click="OnSwitchGestureChanged" />
    </ui:CardControl>

    <ui:CardControl Icon="{ui:SymbolIcon ArrowSwap24}" Margin="0,0,0,8">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Switch target with Ctrl+Alt+CapsLock" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Cycles between this PC and each paired device while capture stays on. Only useful with more than one device: with one phone, the hotkey above already switches. Applies the next time capture starts." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch IsChecked="{Binding EnableCapsLockSwitch, Mode=TwoWay}" />
    </ui:CardControl>

    <ui:CardControl Icon="{ui:SymbolIcon Keyboard24}" Margin="0,0,0,8">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Also switch target with Ctrl+D+C" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Can send a stray D or C to the device you are controlling. Ctrl+Alt+CapsLock always works. Applies the next time capture starts." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch IsChecked="{Binding EnableCtrlDCSwitch, Mode=TwoWay}" />
    </ui:CardControl>

    <ui:CardControl Icon="{ui:SymbolIcon Cast24}" Margin="0,0,0,8">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Receive Wireless with" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Used when Wireless is chosen on Home. PhoneDeck: cast DeX to this PC and PhoneDeck shows it in its own window, with the keyboard, mouse, touch and pen; Windows asks once to let PhoneDeck through the firewall. Wireless Display app: the backup, if PhoneDeck can't receive the cast on this PC." />
        </StackPanel>
      </ui:CardControl.Header>
      <StackPanel>
        <RadioButton GroupName="SettingsWirelessReceiver" Content="PhoneDeck" Margin="0,0,0,4"
                     IsChecked="{Binding WirelessIsPhoneDeck, Mode=TwoWay}" />
        <RadioButton GroupName="SettingsWirelessReceiver" Content="Wireless Display app"
                     IsChecked="{Binding WirelessIsApp, Mode=TwoWay}" />
      </StackPanel>
    </ui:CardControl>

    <ui:CardControl Icon="{ui:SymbolIcon Cursor24}" Margin="0,0,0,8">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Use the touchscreen" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Touch and pen on the video go to the phone, with a button bar below it. Same switch as on Home." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch IsChecked="{Binding TouchLayerEnabled, Mode=TwoWay}" />
    </ui:CardControl>

    <ui:Card Margin="0,0,0,8" Padding="16,12,16,16">
      <StackPanel>
        <ui:TextBlock Text="Phone's screen (capture device)" FontTypography="BodyStrong" />
        <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap" Margin="0,2,0,12"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      Text="Opened with capture when the switch on Home is on. Changes apply the next time it opens." />

        <ui:TextBlock Text="Show it in" FontTypography="Caption" Margin="0,0,0,4" />
        <RadioButton GroupName="SettingsViewer" Content="PhoneDeck's viewer (built in, no mpv needed)" Margin="0,0,0,4"
                     IsChecked="{Binding UseBuiltInViewer, Mode=TwoWay}" />
        <RadioButton GroupName="SettingsViewer" Content="mpv" Margin="0,0,0,10"
                     IsChecked="{Binding UseBuiltInViewer, Mode=TwoWay, Converter={StaticResource InverseBool}}" />

        <ui:TextBlock Text="Video" FontTypography="Caption" Margin="0,0,0,4" />
        <ComboBox x:Name="VideoDeviceBox" IsEditable="True" Margin="0,0,0,10"
                  Text="{Binding ViewerVideoDevice, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

        <ui:TextBlock Text="Sound device (leave empty to use the capture device's own)" FontTypography="Caption" Margin="0,0,0,4" />
        <ComboBox x:Name="AudioDeviceBox" IsEditable="True" Margin="0,0,0,6"
                  Text="{Binding ViewerAudioDevice, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
        <CheckBox Content="Play the sound (off can mean less delay)" Margin="0,0,0,10"
                  IsChecked="{Binding ViewerSound, Mode=TwoWay}" />

        <StackPanel Visibility="{Binding UseBuiltInViewer, Converter={StaticResource InverseBoolToVisibility}}">
          <ui:TextBlock Text="mpv.exe" FontTypography="Caption" Margin="0,0,0,4" />
          <ui:TextBox x:Name="MpvPathBox" Margin="0,0,0,10"
                      Text="{Binding MpvPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
        </StackPanel>

        <StackPanel Visibility="{Binding UseBuiltInViewer, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,10">
          <ui:TextBlock Text="Picture" FontTypography="BodyStrong" Margin="0,4,0,2" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap" Margin="0,0,0,8"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Black and white levels. If colours look too strong, with crushed blacks, try Full. If the picture looks washed out with grey blacks, try Limited. Shows at once, with no added delay." />

          <ComboBox SelectedIndex="{Binding ViewerRange, Mode=TwoWay}">
            <ComboBoxItem Content="Automatic" />
            <ComboBoxItem Content="Full (0 to 255)" />
            <ComboBoxItem Content="Limited (16 to 235)" />
          </ComboBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal">
          <ui:Button Content="Open now" Click="OnOpenViewer" />
          <ui:TextBlock x:Name="ViewerStatus" FontTypography="Caption" VerticalAlignment="Center" Margin="12,0,0,0"
                        TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </StackPanel>
    </ui:Card>

    <ui:CardControl Icon="{ui:SymbolIcon ArrowExit20}">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Exit PhoneDeck" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Stops advertising and removes the tray icon. Hosts will need to reconnect." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:Button Content="Exit" Click="OnExit" />
    </ui:CardControl>

  </StackPanel>
</Page>
