<Page x:Class="BleHid.App.Views.CapturePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:BleHid.App.Converters"
      xmlns:services="clr-namespace:BleHid.App.Services"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="Capture">

  <Page.Resources>
    <conv:InverseBoolConverter x:Key="InverseBool" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  </Page.Resources>

  <StackPanel Margin="24,0,24,24">

      <ui:TextBlock Text="Capture" FontTypography="TitleLarge" Margin="0,0,0,4" />
      <ui:TextBlock Text="Redirect this PC's keyboard and mouse to a paired host."
                    FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" Margin="0,0,0,20" />

      <ui:InfoBar Severity="Warning" IsClosable="False" Margin="0,0,0,16"
                  Title="Capture takes over this PC"
                  Message="While input is going to a host, this window stops receiving it. Press Ctrl+Alt+Q to stop capture, or Ctrl+Alt+CapsLock to switch to the next target."
                  IsOpen="{Binding IsRedirecting}" />

      <ui:InfoBar x:Name="NoHostsBar" Severity="Informational" IsClosable="False" Margin="0,0,0,16"
                  Title="No device connected"
                  Message="On your phone, open Bluetooth settings, tap the gear next to this PC, and tap Connect. If it has never been paired, pair it from there first. On a Windows host, pick the entry shown as an input device rather than the audio one." />

      <ui:InfoBar Severity="Informational" IsClosable="False" Margin="0,0,0,16"
                  Title="Input is staying on this PC"
                  Message="Capture is on, but This PC is selected. Choose a device under Send input to."
                  IsOpen="{Binding IsCapturingLocally}" />

      <ui:CardControl Icon="{ui:SymbolIcon Keyboard24}" Margin="0,0,0,16">
        <ui:CardControl.Header>
          <StackPanel>
            <ui:TextBlock Text="Capture keyboard and mouse" FontTypography="BodyStrong" />
            <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="{Binding Target, StringFormat='Sending to: {0}'}" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch x:Name="CaptureToggle"
                         IsChecked="{Binding IsCapturing, Mode=OneWay}"
                         IsEnabled="{Binding CanCapture}"
                         Click="OnToggleCapture" />
      </ui:CardControl>

      <!-- The same setting as on the Settings page, here because this is where capture starts. -->
      <ui:CardControl Icon="{ui:SymbolIcon Cursor24}" Margin="0,0,0,16">
        <ui:CardControl.Header>
          <StackPanel>
            <ui:TextBlock Text="Use the touchscreen" FontTypography="BodyStrong" />
            <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="Touches on the full-screen video go to the phone, with the button bar below it. Set this before turning capture on." />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch IsChecked="{Binding TouchLayerEnabled, Source={x:Static services:AppSettings.Instance}, Mode=TwoWay}" />
      </ui:CardControl>

      <ui:InfoBar Severity="Warning" IsClosable="False" Margin="0,0,0,16"
                  Title="Lock keys on the target host"
                  Message="{Binding TargetLockWarning, Mode=OneWay}"
                  IsOpen="{Binding HasTargetLockWarning, Mode=OneWay}" />

      <ui:TextBlock Text="Send input to" FontTypography="Subtitle" Margin="0,0,0,8" />

      <ItemsControl ItemsSource="{Binding Targets}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ui:CardControl Margin="0,0,0,8">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="{Binding Title}" FontTypography="BodyStrong" />
                  <ui:TextBlock Text="{Binding Detail}" FontTypography="Caption" TextWrapping="Wrap"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
              </ui:CardControl.Header>
              <RadioButton GroupName="InputTarget"
                           IsChecked="{Binding IsSelected, Mode=TwoWay}"
                           Checked="OnTargetChecked" />
            </ui:CardControl>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ui:TextBlock Text="Pointer" FontTypography="Subtitle" Margin="0,20,0,8" />

      <ui:CardControl Icon="{ui:SymbolIcon Timer24}" Margin="0,0,0,8">
        <ui:CardControl.Header>
          <StackPanel>
            <ui:TextBlock Text="Minimum pointer interval" FontTypography="BodyStrong" />
            <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="{Binding LinkIntervalMs, StringFormat='Paced to {0} ms right now — whichever is slower of this minimum and the connection interval the host negotiated.'}" />
          </StackPanel>
        </ui:CardControl.Header>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Slider Width="160" Minimum="5" Maximum="50" TickFrequency="5" IsSnapToTickEnabled="True"
                  VerticalAlignment="Center"
                  Value="{Binding PointerIntervalMs, Mode=TwoWay}" />
          <ui:TextBlock Width="52" Margin="12,0,0,0" VerticalAlignment="Center"
                        Text="{Binding PointerIntervalMs, StringFormat='{}{0} ms'}" />
        </StackPanel>
      </ui:CardControl>

      <ui:TextBlock Text="Shortcuts" FontTypography="Subtitle" Margin="0,20,0,8" />

      <ui:CardControl Icon="{ui:SymbolIcon ArrowSwap24}" Margin="0,0,0,8">
        <ui:CardControl.Header>
          <ui:TextBlock Text="Switch to the next target" FontTypography="BodyStrong" />
        </ui:CardControl.Header>
        <StackPanel MaxWidth="240">
          <ui:TextBlock Text="Ctrl + Alt + CapsLock" FontFamily="Cascadia Mono, Consolas"
                        FontTypography="Body" TextWrapping="Wrap" />
          <ui:TextBlock x:Name="ChordHint" Text="or Ctrl + D + C" FontFamily="Cascadia Mono, Consolas"
                        FontTypography="Body" TextWrapping="Wrap" Margin="0,4,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </ui:CardControl>

      <ui:CardControl Icon="{ui:SymbolIcon Dismiss24}">
        <ui:CardControl.Header>
          <ui:TextBlock Text="Turn capture on or off" FontTypography="BodyStrong" />
        </ui:CardControl.Header>
        <ui:TextBlock Text="Ctrl + Alt + Q" FontFamily="Cascadia Mono, Consolas"
                      FontTypography="Body" />
      </ui:CardControl>

  </StackPanel>
</Page>
