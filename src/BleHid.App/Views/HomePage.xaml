<Page x:Class="BleHid.App.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:BleHid.App.Converters"
      xmlns:services="clr-namespace:BleHid.App.Services"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="Home">

  <Page.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
    <conv:InverseBoolConverter x:Key="InverseBool" />
  </Page.Resources>

  <!-- Everything needed every time, top to bottom: is the phone there, start, where input goes,
       touch. Logs, encryption and pacing live on the Details page. -->
  <StackPanel Margin="24,0,24,24">

    <ui:TextBlock Text="Home" FontTypography="TitleLarge" Margin="0,0,0,16" />

    <ui:InfoBar Severity="Warning" IsClosable="False" Margin="0,0,0,12"
                Title="Bluetooth is off"
                Message="Start it from the Details page."
                IsOpen="{Binding IsRunning, Converter={StaticResource InverseBool}}" />

    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Width="44" Height="44" CornerRadius="22"
                Background="{DynamicResource ControlFillColorSecondaryBrush}">
          <ui:SymbolIcon Symbol="Bluetooth24" FontSize="22"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
          <ui:TextBlock Text="{Binding Headline}" FontTypography="Subtitle" TextTrimming="CharacterEllipsis" />
          <ui:TextBlock Text="{Binding Detail}" FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Column="2" VerticalAlignment="Center">
          <Border CornerRadius="10" Padding="10,3"
                  Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                  Visibility="{Binding CanCapture, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Ready" FontSize="12"
                       Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
          </Border>
          <Border CornerRadius="10" Padding="10,3"
                  Background="{DynamicResource ControlFillColorSecondaryBrush}"
                  Visibility="{Binding CanCapture, Converter={StaticResource InverseBoolToVisibility}}">
            <TextBlock Text="Not connected" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </Border>
        </Grid>
      </Grid>
    </Border>

    <ui:Button Appearance="Primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
               Height="48" Margin="0,0,0,16"
               IsEnabled="{Binding CanToggleCapture}" Click="OnToggleCapture">
      <StackPanel Orientation="Horizontal">
        <ui:SymbolIcon Symbol="Play24" Margin="0,0,8,0" VerticalAlignment="Center" />
        <TextBlock Text="{Binding CaptureButtonText}" FontSize="15" VerticalAlignment="Center" />
        <TextBlock Text="Ctrl+Alt+Q" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                   Opacity="0.8" Margin="12,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
    </ui:Button>

    <ui:InfoBar Severity="Informational" IsClosable="False" Margin="0,0,0,12"
                Title="Input is staying on this PC"
                Message="Capture is on, but This PC is selected. Choose your phone below."
                IsOpen="{Binding IsCapturingLocally}" />

    <ui:InfoBar Severity="Warning" IsClosable="False" Margin="0,0,0,12"
                Title="Lock keys on the phone"
                Message="{Binding TargetLockWarning, Mode=OneWay}"
                IsOpen="{Binding HasTargetLockWarning, Mode=OneWay}" />

    <ui:TextBlock Text="Send input to" FontTypography="BodyStrong" Margin="0,0,0,8" />
    <ItemsControl ItemsSource="{Binding Targets}" Margin="0,0,0,12">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <RadioButton GroupName="InputTarget" Content="{Binding Title}" Margin="0,0,24,8"
                       IsChecked="{Binding IsSelected, Mode=TwoWay}"
                       Checked="OnTargetChecked" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <ui:CardControl Icon="{ui:SymbolIcon Cursor24}">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Use the touchscreen" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Touches on the full-screen video go to the phone, with a button bar below it. Applies the next time capture starts." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch IsChecked="{Binding TouchLayerEnabled, Source={x:Static services:AppSettings.Instance}, Mode=TwoWay}" />
    </ui:CardControl>

  </StackPanel>
</Page>
