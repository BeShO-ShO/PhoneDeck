<ui:FluentWindow x:Class="PhoneDeck.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="PhoneDeck"
                 Width="400" Height="640"
                 MinWidth="360" MinHeight="480"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

  <!-- A compact companion window: Home is the whole app day to day, and Details and Settings
       open in its place behind the two icons, with a back arrow to return. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="PhoneDeck">
      <ui:TitleBar.Icon>
        <ui:ImageIcon>
          <ui:ImageIcon.Source>
            <!-- DecodePixelWidth picks the 32px frame; without it the decoder's choice of frame
                 is left to chance. -->
            <BitmapImage UriSource="pack://application:,,,/Assets/phonedeck.ico"
                         DecodePixelWidth="32" DecodePixelHeight="32" />
          </ui:ImageIcon.Source>
        </ui:ImageIcon>
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <Grid Grid.Row="1" Margin="8,0,8,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <ui:Button x:Name="BackButton" Grid.Column="0" Appearance="Transparent" Padding="8,6"
                 Click="OnBack" Visibility="Collapsed" ToolTip="Back">
        <Path Data="M10,2 L4,8 L10,14" Stroke="{DynamicResource TextFillColorPrimaryBrush}"
              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              StrokeLineJoin="Round" Width="14" Height="16" />
      </ui:Button>

      <ui:TextBlock x:Name="PageTitle" Grid.Column="1" Text="Home" FontTypography="Subtitle"
                    VerticalAlignment="Center" Margin="8,0,0,0" />

      <ui:Button x:Name="DetailsButton" Grid.Column="2" Appearance="Transparent" Padding="8,6"
                 Click="OnDetails" ToolTip="Details and logs">
        <ui:SymbolIcon Symbol="Info24" />
      </ui:Button>

      <ui:Button x:Name="SettingsButton" Grid.Column="3" Appearance="Transparent" Padding="8,6"
                 Click="OnSettings" ToolTip="Settings">
        <ui:SymbolIcon Symbol="Settings24" />
      </ui:Button>
    </Grid>

    <!-- PanningMode lets a finger drag the page; without it WPF only scrolls by wheel or bar. -->
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly"
                  ManipulationBoundaryFeedback="OnBoundaryFeedback">
      <Frame x:Name="PageHost" NavigationUIVisibility="Hidden" Focusable="False" />
    </ScrollViewer>
  </Grid>
</ui:FluentWindow>
