<Page x:Class="BleHid.App.Views.StatusPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:BleHid.App.Converters"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="Details">

  <Page.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
    <conv:InverseBoolConverter x:Key="InverseBool" />
  </Page.Resources>

  <!-- No page-level ScrollViewer: NavigationView already hosts pages inside one, and a nested
       scroller swallows the wheel without being able to scroll. -->
  <StackPanel Margin="16,4,16,16">

      <ui:TextBlock Text="The Bluetooth service, connection details, pointer pacing, shortcuts, and logs."
                    FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" Margin="0,0,0,20" />

      <ui:InfoBar Severity="Warning" IsClosable="False" Margin="0,0,0,16"
                  Title="Not advertising"
                  Message="Start the peripheral to make this PC discoverable as a Bluetooth keyboard."
                  IsOpen="{Binding IsRunning, Converter={StaticResource InverseBool}}" />

      <ui:InfoBar Severity="Informational" IsClosable="False" Margin="0,0,0,16"
                  Title="No device connected"
                  Message="On your phone, open Bluetooth settings, tap the gear next to this PC, and tap Connect. If it has never been paired, pair it from there first."
                  IsOpen="{Binding NeedsReconnect}" />

      <ui:CardControl Icon="{ui:SymbolIcon PlugConnected24}" Margin="0,0,0,8">
        <ui:CardControl.Header>
          <ui:TextBlock Text="Connection" FontTypography="BodyStrong" />
        </ui:CardControl.Header>
        <ui:TextBlock Text="{Binding ConnectionText}" FontTypography="Body" TextWrapping="Wrap" />
      </ui:CardControl>

      <ui:CardControl Icon="{ui:SymbolIcon Bluetooth24}" Margin="0,0,0,8">
        <ui:CardControl.Header>
          <StackPanel>
            <ui:TextBlock Text="BLE HID peripheral" FontTypography="BodyStrong" />
            <ui:TextBlock FontTypography="Caption"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="{Binding AdvertisementStatus, StringFormat='Advertisement: {0}'}" />
          </StackPanel>
        </ui:CardControl.Header>

        <StackPanel Orientation="Horizontal">
          <ui:Button Content="Start" Appearance="Primary" Click="OnStart"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                     Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVisibility}}" />
          <ui:Button Content="Stop" Click="OnStop"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </ui:CardControl>

      <ui:CardControl Icon="{ui:SymbolIcon LockClosed24}" Margin="0,0,0,8">
        <ui:CardControl.Header>
          <StackPanel>
            <ui:TextBlock Text="Require encryption" FontTypography="BodyStrong" />
            <ui:TextBlock FontTypography="Caption"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="Hosts must bond before they can read reports. Can only be changed while stopped." />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch IsChecked="{Binding RequireEncryption, Mode=TwoWay}"
                         IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />
      </ui:CardControl>

      <Grid Margin="0,0,0,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ui:CardControl Grid.Column="0" Icon="{ui:SymbolIcon Keyboard24}">
          <ui:CardControl.Header>
            <ui:TextBlock Text="Keyboard subscribers" FontTypography="BodyStrong" />
          </ui:CardControl.Header>
          <ui:TextBlock Text="{Binding KeyboardSubscribers}" FontTypography="TitleLarge" />
        </ui:CardControl>

        <ui:CardControl Grid.Column="2" Icon="{ui:SymbolIcon Cursor24}">
          <ui:CardControl.Header>
            <ui:TextBlock Text="Mouse subscribers" FontTypography="BodyStrong" />
          </ui:CardControl.Header>
          <ui:TextBlock Text="{Binding MouseSubscribers}" FontTypography="TitleLarge" />
        </ui:CardControl>
      </Grid>

      <ui:TextBlock Text="Pointer" FontTypography="Subtitle" Margin="0,0,0,8" />

      <ui:CardControl Icon="{ui:SymbolIcon Timer24}" Margin="0,0,0,20">
        <ui:CardControl.Header>
          <StackPanel>
            <ui:TextBlock Text="Minimum pointer interval" FontTypography="BodyStrong" />
            <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="{Binding LinkIntervalMs, StringFormat='Paced to {0} ms right now — whichever is slower of this minimum and the connection interval the phone negotiated.'}" />
          </StackPanel>
        </ui:CardControl.Header>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Slider Width="160" Minimum="5" Maximum="50" TickFrequency="5" IsSnapToTickEnabled="True"
                  VerticalAlignment="Center"
                  Value="{Binding PointerIntervalMs, Mode=TwoWay}" />
          <ui:TextBlock Width="52" Margin="12,0,0,0" VerticalAlignment="Center"
                        Text="{Binding PointerIntervalMs, StringFormat='{}{0} ms'}" />
        </StackPanel>
      </ui:CardControl>

      <ui:TextBlock Text="Shortcuts" FontTypography="Subtitle" Margin="0,0,0,8" />

      <ui:CardControl Icon="{ui:SymbolIcon ArrowSwap24}" Margin="0,0,0,8">
        <ui:CardControl.Header>
          <ui:TextBlock Text="Switch to the next target" FontTypography="BodyStrong" />
        </ui:CardControl.Header>
        <StackPanel MaxWidth="240">
          <ui:TextBlock Text="Ctrl + Alt + CapsLock" FontFamily="Cascadia Mono, Consolas"
                        FontTypography="Body" TextWrapping="Wrap" />
          <ui:TextBlock x:Name="ChordHint" Text="or Ctrl + D + C" FontFamily="Cascadia Mono, Consolas"
                        FontTypography="Body" TextWrapping="Wrap" Margin="0,4,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </ui:CardControl>

      <ui:CardControl Icon="{ui:SymbolIcon Keyboard24}" Margin="0,0,0,20">
        <ui:CardControl.Header>
          <ui:TextBlock Text="Turn capture on or off" FontTypography="BodyStrong" />
        </ui:CardControl.Header>
        <ui:TextBlock Text="Ctrl + Alt + Q" FontFamily="Cascadia Mono, Consolas"
                      FontTypography="Body" />
      </ui:CardControl>

      <ui:TextBlock Text="Logs" FontTypography="Subtitle" Margin="0,0,0,8" />
      <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="1" CornerRadius="8" Height="220">
        <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto" Padding="12">
          <ItemsControl ItemsSource="{Binding Log}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

  </StackPanel>
</Page>
