<Page x:Class="PhoneDeck.App.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:PhoneDeck.App.Converters"
      xmlns:services="clr-namespace:PhoneDeck.App.Services"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="Home">

  <Page.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
    <conv:InverseBoolConverter x:Key="InverseBool" />
  </Page.Resources>

  <!-- Everything needed every time, top to bottom: is the phone there, start, where input goes,
       touch. Logs, encryption and pacing live on the Details page. -->
  <StackPanel Margin="16,4,16,16">

    <ui:InfoBar Severity="Warning" IsClosable="False" Margin="0,0,0,12"
                Title="Bluetooth is off"
                Message="Start it from the Details page."
                IsOpen="{Binding IsRunning, Converter={StaticResource InverseBool}}" />

    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Width="44" Height="44" CornerRadius="22"
                Background="{DynamicResource ControlFillColorSecondaryBrush}">
          <ui:SymbolIcon Symbol="Bluetooth24" FontSize="22"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
          <ui:TextBlock Text="{Binding Headline}" FontTypography="Subtitle" TextWrapping="Wrap" />
          <ui:TextBlock Text="{Binding Detail}" FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Column="2" VerticalAlignment="Center">
          <Border CornerRadius="10" Padding="10,3"
                  Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                  Visibility="{Binding CanCapture, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Ready" FontSize="12"
                       Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
          </Border>
          <Border CornerRadius="10" Padding="10,3"
                  Background="{DynamicResource ControlFillColorSecondaryBrush}"
                  Visibility="{Binding CanCapture, Converter={StaticResource InverseBoolToVisibility}}">
            <TextBlock Text="Not connected" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </Border>
        </Grid>
      </Grid>
    </Border>

    <ui:Button Appearance="Primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
               Height="48" Margin="0,0,0,16"
               IsEnabled="{Binding CanToggleCapture}" Click="OnToggleCapture">
      <StackPanel Orientation="Horizontal">
        <ui:SymbolIcon Symbol="Play24" Margin="0,0,8,0" VerticalAlignment="Center" />
        <TextBlock Text="{Binding CaptureButtonText}" FontSize="15" VerticalAlignment="Center" />
        <TextBlock Text="{Binding CaptureHotkeyText, Source={x:Static services:AppSettings.Instance}}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                   Opacity="0.8" Margin="12,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
    </ui:Button>

    <ui:InfoBar Severity="Informational" IsClosable="False" Margin="0,0,0,12"
                Title="Input is staying on this PC"
                Message="Capture is on, but This PC is selected. Choose your phone below."
                IsOpen="{Binding IsCapturingLocally}" />

    <ui:InfoBar Severity="Warning" IsClosable="False" Margin="0,0,0,12"
                Title="Lock keys on the phone"
                Message="{Binding TargetLockWarning, Mode=OneWay}"
                IsOpen="{Binding HasTargetLockWarning, Mode=OneWay}" />

    <ui:TextBlock Text="Send input to" FontTypography="BodyStrong" Margin="0,0,0,8" />
    <ItemsControl ItemsSource="{Binding Targets}" Margin="0,0,0,12">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <RadioButton GroupName="InputTarget" Content="{Binding Title}" Margin="0,0,24,8"
                       IsChecked="{Binding IsSelected, Mode=TwoWay}"
                       Checked="OnTargetChecked" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- How the phone's screen is shown, and below it only the options that apply to that way. -->
    <ui:TextBlock Text="Show the phone's screen with" FontTypography="BodyStrong" Margin="0,4,0,8" />
    <WrapPanel Margin="0,0,0,8">
      <RadioButton GroupName="HomeDisplayRoute" Content="Capture device" Margin="0,0,24,4"
                   IsChecked="{Binding RouteIsCaptureDevice, Source={x:Static services:AppSettings.Instance}, Mode=TwoWay}" />
      <RadioButton GroupName="HomeDisplayRoute" Content="Wireless" Margin="0,0,0,4"
                   IsChecked="{Binding RouteIsWireless, Source={x:Static services:AppSettings.Instance}, Mode=TwoWay}" />
    </WrapPanel>

    <!-- PhoneDeck's own receiver: its state, so "is it ready?" needs no guessing. -->
    <ui:CardControl Icon="{ui:SymbolIcon Cast24}" Margin="0,0,0,8"
                    Visibility="{Binding RouteIsCast, Source={x:Static services:AppSettings.Instance}, Converter={StaticResource BoolToVisibility}}">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Cast DeX to this PC" FontTypography="BodyStrong" />
          <ui:TextBlock x:Name="CastStatusText" FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </ui:CardControl.Header>
    </ui:CardControl>

    <StackPanel Visibility="{Binding RouteIsWirelessDisplayApp, Source={x:Static services:AppSettings.Instance}, Converter={StaticResource InverseBoolToVisibility}}">
      <ui:CardControl Icon="{ui:SymbolIcon Play24}" Margin="0,0,0,8"
                      Visibility="{Binding RouteIsCaptureDevice, Source={x:Static services:AppSettings.Instance}, Converter={StaticResource BoolToVisibility}}">
        <ui:CardControl.Header>
          <StackPanel>
            <ui:TextBlock Text="Open the phone's screen" FontTypography="BodyStrong" />
            <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="Opens it when capture starts. Viewer and device in Settings." />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch IsChecked="{Binding OpenViewerWithCapture, Source={x:Static services:AppSettings.Instance}, Mode=TwoWay}" />
      </ui:CardControl>

      <ui:CardControl Icon="{ui:SymbolIcon Speaker224}" Margin="0,0,0,8">
        <ui:CardControl.Header>
          <StackPanel>
            <ui:TextBlock Text="Play the phone's sound" FontTypography="BodyStrong" />
            <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="From the capture device or the cast. Off can mean less delay with a capture device." />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch IsChecked="{Binding ViewerSound, Source={x:Static services:AppSettings.Instance}, Mode=TwoWay}" />
      </ui:CardControl>

      <ui:CardControl Icon="{ui:SymbolIcon Cursor24}">
        <ui:CardControl.Header>
          <StackPanel>
            <ui:TextBlock Text="Use the touchscreen" FontTypography="BodyStrong" />
            <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="Touch and pen on the video go to the phone, with a button bar below it." />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch IsChecked="{Binding TouchLayerEnabled, Source={x:Static services:AppSettings.Instance}, Mode=TwoWay}" />
      </ui:CardControl>
    </StackPanel>

    <ui:CardControl Icon="{ui:SymbolIcon Cast24}"
                    Visibility="{Binding RouteIsWirelessDisplayApp, Source={x:Static services:AppSettings.Instance}, Converter={StaticResource BoolToVisibility}}">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Cast DeX to the Wireless Display app" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Touch works through the cast; PhoneDeck adds the keyboard, mouse and pen. Don't minimise Wireless Display: use the bar's buttons to fill the screen or send it back." />
        </StackPanel>
      </ui:CardControl.Header>
    </ui:CardControl>

    <ui:Button Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
               Margin="0,12,0,0" Padding="12,10" Click="OnDetails">
      <Grid>
        <TextBlock Text="Details and logs" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Data="M2,2 L8,8 L2,14"
              Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="1.6"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
      </Grid>
    </ui:Button>

  </StackPanel>
</Page>
